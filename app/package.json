{
  "name": "stencilator-app",
  "private": true,
  "version": "0.1.0",
  "description": "The Stencilator web app: the engine runs in the browser, and nothing is uploaded.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "wasm": "make -C .. wasm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run deps && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "knip": "knip",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "26.6.7",
    "@types/three": "0.187.0",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "three": "0.187.0"
  }
}
